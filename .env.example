# Optional natural-language provider. Default "rules" (deterministic, no network).
EHDS_NL_PROVIDER=rules
# For EHDS_NL_PROVIDER=ollama (local model, untested in this prototype)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=mistral
# For EHDS_NL_PROVIDER=mistral (European API, untested in this prototype) - never commit a real key
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Disclosure ledger: shared (default, all released results count) or applicant
EHDS_DISCLOSURE_AUDIENCE=shared
